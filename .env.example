# 复制为 .env 后可覆盖默认值（docker compose 自动读取）
MYSQL_ROOT_PASSWORD=root123456
JWT_SECRET=patent-cloud-dev-secret-change-me

# 代理所所在地时区：期限「今日/剩余天数/逾期」按此时区计算（存储一律 UTC 日历日）
FIRM_TZ=Asia/Shanghai

# 定稿附件对象存储：local 落盘（compose 下挂 patent_storage 持久卷，零依赖）
# 生产改为 s3，指向 MinIO / AWS / 任意 S3 兼容端点
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=patent-cloud
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
